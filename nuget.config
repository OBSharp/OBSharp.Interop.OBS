<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--To inherit the global NuGet package sources remove the <clear/> line below -->
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <!--本仓库通过 dotnet-tools.json 使用 OBSharp 发布的绑定生成器，需从 GitHub Packages 还原-->
    <add key="OBSharp" value="https://nuget.pkg.github.com/OBSharp/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
    <packageSource key="OBSharp">
      <package pattern="OBSharp.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
